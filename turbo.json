{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "//#typecheck": {
      "inputs": [
        "module.ts",
        "prisma.config.ts",
        "tsconfig.json",
        "package.json",
        "packages/**",
        "services/**"
      ],
      "outputs": []
    },
    "//#test": {
      "inputs": [
        "package.json",
        "packages/**",
        "services/**"
      ],
      "outputs": []
    }
  }
}
