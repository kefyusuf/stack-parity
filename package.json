{
  "name": "stack-parity",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run //#typecheck //#test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @stack-parity/public-api test",
    "compute:dev": "prisma dev module.ts",
    "compute:deploy": "prisma deploy module.ts --stage spike-001"
  },
  "dependencies": {
    "@prisma/composer": "0.39.0",
    "@prisma/composer-prisma-cloud": "0.39.0",
    "@prisma/orm-postgres": "8.0.0-rc.17",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.1.5",
    "@effect/platform-node": "4.1.5",
    "@types/bun": "1.4.5",
    "prisma": "8.0.0-rc.22",
    "turbo": "2.11.13",
    "typescript": "7.0.2"
  }
}
